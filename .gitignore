# Build output and intermediate artefacts.  The canonical .pkt files are
# committed at the repository root; re-running a generator writes fresh copies
# under generator/out/ and generator/build/.
__pycache__/
*.pyc
generator/out/
generator/build/
generator/docs/
generator/*.pkt
# Per-lab subdirectories (generator/<lab>/) follow the same rule: the
# canonical .pkt files are committed at the repository root and each lab's
# published documents under docs/<lab>/.
generator/*/out/
generator/*/build/
generator/*/docs/
